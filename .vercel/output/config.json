{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/twitch-live",
      "dest": "/api/twitch-live"
    },
    {
      "src": "/api/live",
      "dest": "/api/live"
    },
    {
      "src": "/api/hiscores",
      "dest": "/api/hiscores"
    },
    {
      "src": "/api/healthz",
      "dest": "/api/healthz"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}